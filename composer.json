{
    "name": "poomconnect/poomconnect",
    "description": "Poom Connect — multi-tenant speed-networking events platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^21.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PoomConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PoomConnect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php migrate.php",
        "pretty-dirs": "php scripts/build-pretty-dirs.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
