# Copy this file to .env and fill in real values. Never commit .env.

APP_URL=
APP_ENV=local

# Extensionless URLs (/login). Leave unset: on for Apache, off for nginx.
# Set true only after aaPanel rewrite is working (see deploy/aapanel-rewrite.conf).
PRETTY_URLS=

DB_HOST=localhost
DB_NAME=poomconnect
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Generate with: php -r "echo base64_encode(random_bytes(32));"
# Used to encrypt payment gateway secrets (Stripe/Omise/PayPal/2C2P credentials) at rest.
# Changing this after secrets have been saved will make existing encrypted values unreadable.
APP_ENCRYPTION_KEY=
